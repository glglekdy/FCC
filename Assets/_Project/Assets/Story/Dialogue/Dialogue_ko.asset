  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_ko
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 5e06240941985684099e5e2e5e2644a2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57801703424
    m_Localized: "\uC11C\uCEE4\uC2A4 \uB2E8\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 15616805875748864
    m_Localized: ??
    m_Metadata:
      m_Items: []
  - m_Id: 15616805875752960
    m_Localized: ???
    m_Metadata:
      m_Items: []
  - m_Id: 57814286336
    m_Localized: "<speed=60>\uC5B4\uC11C \uC624\uAC8C, \uC190\uB2D8!</speed> \uC774
      \uB0A1\uC740 \uC11C\uCEE4\uC2A4 \uADF9\uC7A5\uC5D0 <bold>\uC624\uC2E0 \uAC78
      \uD658\uC601\uD558\uB124.</bold>"
    m_Metadata:
      m_Items: []
  - m_Id: 57826869248
    m_Localized: "<shake a=6 s=40>\uC870\uC2EC\uD558\uAC8C!</shake> \uC774 \uBB34\uB300
      \uC544\uB798\uC5D0\uB294 \uBB34\uC5B8\uAC00 <wave>\uAFC8\uD2C0\uAC70\uB9AC\uACE0</wave>
      \uC788\uB2E4\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 57843646464
    m_Localized: "<rainbow s=2>\uD654\uB824\uD55C \uC870\uBA85</rainbow> \uC544\uB798,
      \uADF8\uB300\uB294 <round r=4 s=5>\uACF5\uC911\uADF8\uB124</round>\uCC98\uB7FC
      \uC6B4\uBA85\uC744 \uB9F4\uB3CC\uAC8C \uB420 \uAC78\uC138."
    m_Metadata:
      m_Items: []
  - m_Id: 15614216484421632
    m_Localized: "<shake a=1>\uC5EC\uAE34 \uC5B4\uB514\uC9C0\u2026.</shake>"
    m_Metadata:
      m_Items: []
  - m_Id: 15614806379724800
    m_Localized: "\uC800\uC2B9\uC758 \uC11C\uCEE4\uC2A4\uC5D0 \uC624\uC2E0 \uC5EC\uB7EC\uBD84
      <round>\uD658\uC601\uD569\uB2C8\uB2E4!</round>"
    m_Metadata:
      m_Items: []
  - m_Id: 15615341296091136
    m_Localized: "\uC624\uB298\uB3C4 \uC5B4\uB5A4 \uC990\uAC70\uC6B4 \uC1FC\uAC00
      \uC800\uD76C\uB97C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 15615405926121472
    m_Localized: "\uADF8\uB7FC \uD55C\uBC88 \uB9CC\uB098\uBCF4\uB7EC \uAC00\uC2DC\uC8E0!"
    m_Metadata:
      m_Items: []
  - m_Id: 15615554589032448
    m_Localized: "(\uACBD\uCF8C\uD558\uBA74\uC11C\uB3C4 \uBD88\uCF8C\uD55C \uC11C\uCEE4\uC2A4
      \uC74C\uC545\uC774 \uD758\uB7EC\uB098\uC628\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 15616805875757056
    m_Localized: "\uC774 \uAC70\uC6B8\uC5D0\uC11C \uB098\uC654\uB358\uAC70 \uAC19\uC740\uB370\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 15615680212631552
    m_Localized: "<shake>\uB0B4\uAC00\u2026 \uC65C \uAC70\uC6B8\uC5D0\uC11C \uB098\uC628\uAC70\uC9C0\u2026?</shake>"
    m_Metadata:
      m_Items: []
  - m_Id: 15616805875761152
    m_Localized: "\uC800\uAE34 \uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB098\uACE0
      \uC788\uB294\uAC70\uC9C0\u2026."
    m_Metadata:
      m_Items: []
  - m_Id: 15615758281211904
    m_Localized: "(\uCEE4\uD2BC\uC774 \uCCD0\uC838 \uC788\uC5B4\uC11C \uC798 \uC548\uBCF4\uC774\uC9C0\uB9CC
      \uCEE4\uD2BC \uB4A4\uC5D0\uC11C \uACC4\uC18D\uD574\uC11C \uAD00\uAC1D\uB4E4\uC758
      \uC6C3\uC74C \uC18C\uB9AC\uC640 \uB178\uB798, \uADF8\uB9AC\uACE0 \uC11C\uCEE4\uC2A4
      \uB2E8\uC6D0\uB4E4\uC774 \uACF5\uC5F0\uD558\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 15615827193626624
    m_Localized: "<shake>\uC5EC\uAE30 \uB300\uCCB4\u2026. \uBB50\uC57C\u2026.?</shake>"
    m_Metadata:
      m_Items: []
  - m_Id: 15615916209340416
    m_Localized: "(\uADF8\uB54C \uCEE4\uD2BC \uBC16 \uBB34\uB300\uC5D0\uC11C <shake
      a=2>\uCF85!</shake> \uD558\uACE0 \uD070 \uC18C\uB9AC\uAC00 \uB4E4\uB9AC\uBA74\uC11C
      \uB204\uAD70\uAC00\uC758 \uBE44\uBA85 \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4.
      \uD558\uC9C0\uB9CC \uADF8\uB7FC\uC5D0\uB3C4 \uAD00\uAC1D\uB4E4\uC740 \uB180\uB77C\uAE30\uB294\uCEE4\uB155
      \uBE44\uC6C3\uB294 \uC18C\uB9AC, \uD3ED\uC18C\uD558\uB294 \uC18C\uB9AC, \uBC15\uC218
      \uC18C\uB9AC\uBC16\uC5D0 \uC548 \uB4E4\uB9AC\uB294 \uAC83 \uAC19\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 15616729136758784
    m_Localized: "(\uADF8\uB807\uAC8C \uACF5\uC5F0\uC740 \uBB34\uC0AC\uD788? \uB05D\uB09C
      \uAC83 \uAC19\uC558\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 15616758543024128
    m_Localized: "(\uC11C\uCEE4\uC2A4 \uB2E8\uC6D0\uB4E4\uC774 \uBC31\uC2A4\uD14C\uC774\uC9C0\uB85C
      \uB4E4\uC5B4\uC624\uAE30 \uC804\uAE4C\uC9C0\uB294 \uBAB0\uB790\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 15616805875744768
    m_Localized: "(\uADF8\uB54C \uD55C \uAC70\uAD6C\uC758 \uC0AC\uB0B4\uAC00 \uBC31\uC2A4\uD14C\uC774\uC9C0\uB85C
      \uB4E4\uC5B4\uC654\uB2E4. \uADF8\uC790\uAC00 \uB4E4\uC5B4\uC624\uC790 \uB2E8\uC6D0\uB4E4\uC740
      \uBAA8\uB450 \uAC81\uC5D0 \uC9C8\uB9B0 \uB4EF\uD55C \uB208\uC744 \uD558\uACE0
      \uC788\uC5C8\uB2E4. \uADF8\uB9AC\uACE0 \uC2E4\uC218\uB97C \uD55C \uB4EF\uD55C
      \uB2E8\uC6D0\uC744 \uB04C\uACE0 \uC5B4\uB460 \uC18D\uC73C\uB85C \uC0AC\uB77C\uC84C\uB2E4.
      \uADF8\uB9AC\uACE0 \uB2E8\uB9D0\uB9C8\uC758 \uBE44\uBA85\uC18C\uB9AC\uB9CC\uC774
      \uD758\uB7EC\uB098\uC62C \uBFD0\uC774\uC5C8\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 17483213807026176
    m_Localized: "(\uBA38\uB9AC\uAC00 \uAE68\uC9C8 \uAC83\uB9CC \uAC19\uC740 \uACE0\uD1B5\uC774
      \uBC00\uB824\uC654\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 17483213853163520
    m_Localized: "(\uB208\uC744 \uB728\uC790 \uB0AF\uC120 \uC7A5\uC18C\uC5D0 \uC5CE\uC5B4\uC838
      \uC788\uC5C8\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 17483213890912256
    m_Localized: "(\uADF8\uB54C \uCEE4\uD2BC \uB4A4\uB85C \uC0AC\uB78C\uC758 \uBAA9\uC18C\uB9AC\uAC00
      \uB4E4\uB824\uC654\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 17483213916078080
    m_Localized: "(\uADF8\uB7EC\uC790 \uC6B0\uB8B0\uC640\uB3C4 \uAC19\uC740 \uD568\uC131\uC18C\uB9AC\uAC00
      \uB4E4\uB824\uC654\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 17483213953826816
    m_Localized: "(\uAC70\uC6B8\uC740 \uB454\uAE30\uC5D0 \uAC00\uACA9 \uB2F9\uD55C
      \uB4EF \uAE68\uC9C0\uACE0 \uBD80\uC11C\uC838 \uC788\uC5C8\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 17483213995769856
    m_Localized: "(\uC65C \uAC70\uC6B8\uC5D0\uC11C \uB098\uC654\uB294\uC9C0 \uAC70\uC6B8\uC5D0\uC11C
      \uB098\uC624\uAE30 \uC804\uC5D0 \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB358\uAC74\uC9C0
      \uC544\uBB34 \uAE30\uC5B5\uB3C4 \uC5C6\uC5C8\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 17483214029324288
    m_Localized: "(\uB9C8\uCE58 \uC6D0\uB798\uBD80\uD130 \uC874\uC7AC\uD558\uC9C0
      \uC54A\uC558\uB358 \uAC83\uCC98\uB7FC.)"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
