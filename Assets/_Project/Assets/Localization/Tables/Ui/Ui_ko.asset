    m_Metadata:
      m_Items: []
  - m_Id: 4475322368
    m_Localized: "\uC2AC\uB86F {0} \uC5D0 \uC7A5\uCC29 \uC911"
    m_Metadata:
      m_Items: []
  - m_Id: 4500488192
    m_Localized: "\uC7A5\uCC29\uB418\uC5B4 \uC788\uC9C0 \uC54A\uC74C \xB7 Enter \uB85C
      \uACE0\uB978 \uC2AC\uB86F\uC5D0 \uB07C\uC6C1\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 4521459712
    m_Localized: "\uC544\uC9C1 \uB5A0\uC62C\uB9AC\uC9C0 \uBABB\uD55C \uAE30\uC5B5"
    m_Metadata:
      m_Items: []
  - m_Id: 4534042624
    m_Localized: "\uAC15\uD654 \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 4559208448
    m_Localized: "\uC774\uB984 \uC5C6\uB294 \uC2A4\uD0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 4584374272
    m_Localized: Pure Dream
    m_Metadata:
      m_Items: []
  - m_Id: 4605345792
    m_Localized: "\uC8FC\uC778\uACF5 \xB7 \uC815\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 4630511616
    m_Localized: "\uC804\uBC29\uC5D0 \uC815\uD654\uC758 \uD30C\uB3D9\uC744 \uD130\uB728\uB824
      \uC8FC\uBCC0\uC744 \uBC00\uC5B4\uB0B4\uACE0, \uADF8 \uBC18\uB3D9\uC73C\uB85C
      \uC790\uC544\uB97C \uC870\uAE08 \uB418\uCC3E\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4651483136
    m_Localized: Broken Phantasm
    m_Metadata:
      m_Items: []
  - m_Id: 4676648960
    m_Localized: "\uCE7C\uC7A1\uC774 \xB7 \uD22C\uC0AC\uCCB4"
    m_Metadata:
      m_Items: []
  - m_Id: 4701814784
    m_Localized: "\uCE7C\uC7A1\uC774\uC758 \uD22C\uC0AC\uCCB4 \uC2A4\uD0AC. \uC804\uBC29\uC73C\uB85C
      \uCE7C\uC744 \uBD80\uCC44\uAF34\uB85C \uB358\uC838 \uB9DE\uC740 \uB300\uC0C1\uC5D0\uAC8C
      \uD53C\uD574\uB97C \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4726980608
    m_Localized: Cycle of Fate
    m_Metadata:
      m_Items: []
  - m_Id: 4747952128
    m_Localized: "\uC800\uAE00\uB7EC \xB7 \uC2A4\uD0DD \uD3ED\uBC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 4773117952
    m_Localized: "\uC800\uAE00\uB7EC\uC758 \uAE30\uBCF8 \uACF5 \uC2A4\uD0AC. \uC804\uBC29\uC73C\uB85C
      \uACF5\uC744 \uB358\uC9C4\uB2E4. \uB358\uC9C8 \uB54C\uB9C8\uB2E4 {\uD3ED\uBC1C\uD558\uB294
      \uACF5} \uC2A4\uD0DD\uC774 \uC313\uC774\uACE0, \uC2A4\uD0DD\uC774 \uB2E4 \uCC2C
      \uC0C1\uD0DC\uC5D0\uC11C \uB2E4\uC2DC \uB358\uC9C0\uBA74 \uC774\uBC88 \uACF5\uC774
      \uBA85\uC911 \uC2DC \uD3ED\uBC1C\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4798283776
    m_Localized: Invisible Reality
    m_Metadata:
      m_Items: []
  - m_Id: 4823449600
    m_Localized: "\uB9C8\uC784 \xB7 \uD22C\uBA85 \uBCBD"
    m_Metadata:
      m_Items: []
  - m_Id: 4848615424
    m_Localized: "\uC77C\uC815 \uC2DC\uAC04 \uC720\uC9C0\uB418\uB294 \uD22C\uBA85
      \uBCBD\uC744 \uC124\uCE58\uD574 \uBAAC\uC2A4\uD130\xB7\uD22C\uC0AC\uCCB4\xB7\uC774\uB3D9\uC744
      \uB9C9\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4873781248
    m_Localized: Close Call
    m_Metadata:
      m_Items: []
  - m_Id: 4890558464
    m_Localized: "\uACE1\uC608\uC0AC \xB7 \uAD6C\uC18D \xB7 \uCC98\uD615"
    m_Metadata:
      m_Items: []
  - m_Id: 4911529984
    m_Localized: "\uC904\uC744 \uB358\uC838 \uB9DE\uC740 \uC801\uC744 \uBB36\uB294\uB2E4.
      \uCCB4\uB825\uC774 \uC5BC\uB9C8 \uB0A8\uC9C0 \uC54A\uC740 \uC801\uC774\uBA74
      \uC904\uC744 \uD0C0\uACE0 \uB0A0\uC544\uAC00 \uB4E4\uC774\uBC1B\uC544 \uB05D\uB0B8\uB2E4.
      \uB0A0\uC544\uAC00\uB294 \uB3D9\uC548\uC5D0\uB294 \uBB34\uC801\uC774\uB2E4."
    m_Metadata:
      m_Items: []
